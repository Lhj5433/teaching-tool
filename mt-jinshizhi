<!DOCTYPE html>
<html lang="zh-Hans">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>一年级数学：近似值太空大对决</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Microsoft YaHei", "PingFang SC", Arial, sans-serif;
      color: white;
      overflow: hidden;
      background:
        radial-gradient(circle at 15% 20%, rgba(255,255,255,.35) 0 2px, transparent 3px),
        radial-gradient(circle at 80% 10%, rgba(255,255,255,.4) 0 3px, transparent 4px),
        radial-gradient(circle at 70% 75%, rgba(255,255,255,.28) 0 2px, transparent 3px),
        radial-gradient(circle at 30% 70%, rgba(255,255,255,.22) 0 2px, transparent 3px),
        linear-gradient(135deg, #15004d 0%, #25127a 35%, #3f0a75 65%, #091b64 100%);
    }

    .game {
      position: relative;
      height: 100vh;
      padding: 16px 22px 18px;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 10px;
    }

    .planet {
      position: absolute;
      border-radius: 50%;
      opacity: .95;
      pointer-events: none;
      filter: drop-shadow(0 0 18px rgba(255,255,255,.28));
    }
    .planet.one { width: 92px; height: 92px; left: 32px; bottom: 28px; background: radial-gradient(circle at 30% 30%, #42ffb0, #1580ff 55%, #0d2870); }
    .planet.two { width: 120px; height: 120px; right: 26px; top: 18px; background: radial-gradient(circle at 35% 30%, #ff8ccb, #d22c85 55%, #6b1457); }
    .planet.three { width: 58px; height: 58px; left: 50%; bottom: 18px; background: radial-gradient(circle at 30% 25%, #ffd36a, #ff7b35, #6b1d6b); }

    .stars-bg span {
      position: absolute;
      color: #fff7a8;
      text-shadow: 0 0 14px #fff, 0 0 24px #ffe45e;
      animation: twinkle 1.8s infinite alternate;
      pointer-events: none;
    }
    .stars-bg span:nth-child(1){ left:10%; top:10%; font-size:24px; }
    .stars-bg span:nth-child(2){ left:90%; top:20%; font-size:30px; animation-delay:.4s; }
    .stars-bg span:nth-child(3){ left:44%; top:12%; font-size:20px; animation-delay:.8s; }
    .stars-bg span:nth-child(4){ left:62%; top:88%; font-size:28px; animation-delay:.2s; }
    .stars-bg span:nth-child(5){ left:22%; top:86%; font-size:18px; animation-delay:1s; }
    @keyframes twinkle { from { transform: scale(.85); opacity:.45; } to { transform: scale(1.15); opacity:1; } }

    header { text-align: center; z-index: 2; }
    h1 {
      margin: 0;
      font-size: clamp(34px, 4vw, 62px);
      letter-spacing: 2px;
      color: #ffef52;
      -webkit-text-stroke: 2px #0b3cba;
      text-shadow: 0 4px 0 #ff4bb8, 0 0 22px rgba(255,255,255,.85);
    }
    .subtitle {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin-top: 6px;
      padding: 8px 28px;
      border-radius: 999px;
      background: linear-gradient(90deg, #7a20ff, #ff3eb8, #23c8ff);
      box-shadow: 0 0 18px rgba(255,255,255,.35), inset 0 0 14px rgba(255,255,255,.28);
      font-weight: 900;
      font-size: clamp(16px, 1.5vw, 24px);
    }
    .focus {
      width: fit-content;
      margin: 8px auto 0;
      padding: 7px 24px;
      border-radius: 18px;
      background: rgba(0, 33, 117, .78);
      border: 3px solid #35e9ff;
      box-shadow: 0 0 16px rgba(53,233,255,.55);
      font-size: clamp(15px, 1.35vw, 22px);
      font-weight: 900;
    }
    .focus b { color:#ffef52; }

    main {
      z-index: 2;
      display: grid;
      grid-template-columns: 1fr .82fr 1fr;
      gap: 16px;
      align-items: stretch;
      min-height: 0;
    }

    .team {
      border-radius: 30px;
      padding: 12px;
      border: 4px solid rgba(255,255,255,.7);
      box-shadow: 0 0 24px rgba(255,255,255,.3), inset 0 0 22px rgba(255,255,255,.2);
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: 10px;
      min-width: 0;
    }
    .team.blue { background: linear-gradient(180deg, rgba(30,141,255,.92), rgba(2,41,178,.92)); }
    .team.pink { background: linear-gradient(180deg, rgba(255,72,170,.92), rgba(158,0,112,.92)); }

    .team-title {
      text-align: center;
      font-size: clamp(24px, 2.6vw, 42px);
      font-weight: 1000;
      color: white;
      text-shadow: 0 3px 0 rgba(0,0,0,.25), 0 0 14px rgba(255,255,255,.8);
    }

    .question-card {
      background: rgba(255,255,255,.96);
      color: #101223;
      border-radius: 28px;
      padding: 18px;
      border: 5px solid rgba(255,255,255,.85);
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: inset 0 0 18px rgba(74,165,255,.26);
    }
    .question-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: clamp(24px, 2.2vw, 38px);
      font-weight: 1000;
      line-height: 1.25;
    }
    .qbadge {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 56px; height: 56px;
      border-radius: 50%;
      color: white;
      font-size: 24px;
      box-shadow: inset 0 -5px rgba(0,0,0,.18), 0 3px 8px rgba(0,0,0,.25);
    }
    .blue .qbadge { background: #0c6cff; }
    .pink .qbadge { background: #e91e83; }

    .visual-stars {
      text-align: center;
      font-size: clamp(26px, 3vw, 46px);
      letter-spacing: 8px;
      line-height: 1.15;
      margin: 10px 0 4px;
      filter: drop-shadow(0 0 6px #ffd91f);
    }

    .options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 10px;
    }
    button.option {
      border: none;
      min-height: 74px;
      border-radius: 22px;
      font-size: clamp(25px, 3vw, 44px);
      color: white;
      font-weight: 1000;
      cursor: pointer;
      box-shadow: inset 0 4px rgba(255,255,255,.42), inset 0 -8px rgba(0,0,0,.18), 0 8px 0 rgba(0,0,0,.23);
      transition: transform .12s ease, filter .12s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      touch-action: manipulation;
    }
    .blue button.option { background: linear-gradient(180deg, #43c9ff, #075bd8); }
    .pink button.option { background: linear-gradient(180deg, #ff87c9, #d00071); }
    button.option:active { transform: translateY(6px); box-shadow: inset 0 4px rgba(255,255,255,.35), inset 0 -5px rgba(0,0,0,.2), 0 2px 0 rgba(0,0,0,.25); }
    button.option.correct { outline: 8px solid #ffef52; filter: brightness(1.15); }
    button.option.wrong { outline: 8px solid #ff473d; filter: grayscale(.15) brightness(.85); }
    .letter {
      background: rgba(0,0,0,.22);
      border: 3px solid rgba(255,255,255,.75);
      border-radius: 50%;
      width: 54px; height: 54px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .score-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 18px;
      border-radius: 20px;
      background: rgba(0,0,0,.32);
      border: 3px dashed rgba(255,255,255,.75);
      font-size: clamp(26px, 3vw, 46px);
      font-weight: 1000;
      box-shadow: inset 0 0 16px rgba(255,255,255,.16);
    }
    .score { color: #ffef52; font-size: 1.18em; text-shadow: 0 0 10px #fff36a; }
    .trophy { font-size: 48px; filter: drop-shadow(0 0 10px #ffd642); }
    .stars-earned { min-height: 42px; font-size: 28px; letter-spacing: 2px; }

    .center-panel {
      border-radius: 30px;
      border: 4px solid #a453ff;
      background: rgba(20, 7, 73, .88);
      box-shadow: 0 0 24px rgba(190,91,255,.7), inset 0 0 22px rgba(255,255,255,.18);
      padding: 14px;
      display: grid;
      grid-template-rows: auto 1fr 1fr auto auto;
      gap: 10px;
      min-width: 0;
    }
    .round-note {
      text-align: center;
      border: 3px dashed #fff;
      border-radius: 18px;
      padding: 8px;
      font-size: clamp(18px, 1.8vw, 28px);
      font-weight: 1000;
      background: rgba(255,255,255,.08);
    }
    .feedback-card {
      border-radius: 22px;
      padding: 12px;
      display: grid;
      grid-template-columns: 90px 1fr;
      align-items: center;
      gap: 12px;
      border: 3px solid;
      min-height: 0;
    }
    .good { border-color:#ffef52; background: rgba(255,207,24,.11); }
    .bad { border-color:#ff466f; background: rgba(255,42,88,.12); }
    .big-star {
      font-size: 76px;
      text-align: center;
      filter: drop-shadow(0 0 18px #ffef52);
      animation: glow 1s infinite alternate;
    }
    @keyframes glow { from { transform: scale(.95) rotate(-4deg); } to { transform: scale(1.08) rotate(4deg); } }
    .meteor-scene {
      position: relative;
      height: 90px;
      font-size: 54px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .meteor-scene .ship { transform: rotate(-18deg); animation: bump 1.1s infinite; }
    .meteor-scene .rock { margin-left: -8px; filter: drop-shadow(0 0 10px #ff7b35); }
    @keyframes bump { 0%,100%{ transform: translateX(-6px) rotate(-18deg); } 50%{ transform: translateX(8px) rotate(-10deg); } }
    .feedback-text { font-size: clamp(18px, 1.7vw, 30px); font-weight: 1000; line-height: 1.2; }
    .feedback-text .yellow { color:#ffef52; font-size:1.25em; }
    .feedback-text .red { color:#ff6282; font-size:1.05em; }
    .sound { font-size: .72em; color:#c9f6ff; margin-top: 4px; }

    .controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .main-btn, .small-btn {
      border: none;
      border-radius: 18px;
      padding: 14px 8px;
      font-size: clamp(18px, 1.6vw, 28px);
      font-weight: 1000;
      cursor: pointer;
      color: #08125e;
      background: linear-gradient(180deg, #fff35b, #ffad12);
      box-shadow: inset 0 4px rgba(255,255,255,.5), 0 7px 0 rgba(99,42,0,.5);
      touch-action: manipulation;
    }
    .small-btn { background: linear-gradient(180deg, #9fffff, #36b8ff); color:#061b75; }
    .main-btn:active, .small-btn:active { transform: translateY(5px); box-shadow: inset 0 4px rgba(255,255,255,.45), 0 2px 0 rgba(0,0,0,.35); }

    .result-banner {
      text-align: center;
      min-height: 50px;
      border-radius: 16px;
      padding: 8px;
      font-size: clamp(18px, 1.6vw, 28px);
      font-weight: 1000;
      background: rgba(255,255,255,.12);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    footer {
      z-index: 2;
      text-align: center;
      font-size: clamp(13px, 1.15vw, 18px);
      font-weight: 800;
      color: #eaf6ff;
      opacity: .95;
    }

    .overlay {
      position: fixed;
      inset: 0;
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 20;
    }
    .pop {
      transform: scale(0);
      opacity: 0;
      font-size: clamp(56px, 9vw, 150px);
      font-weight: 1000;
      text-align: center;
      text-shadow: 0 0 30px white;
    }
    .pop.show-correct {
      animation: popStar 1.1s ease-out;
      color:#ffef52;
    }
    .pop.show-wrong {
      animation: popRock 1.1s ease-out;
      color:#ff7272;
    }
    @keyframes popStar {
      0% { transform: scale(.2) rotate(-20deg); opacity:0; }
      25% { transform: scale(1.2) rotate(8deg); opacity:1; }
      70% { transform: scale(1) rotate(0); opacity:1; }
      100% { transform: scale(.85); opacity:0; }
    }
    @keyframes popRock {
      0% { transform: scale(.2); opacity:0; }
      25% { transform: scale(1.1) rotate(-5deg); opacity:1; }
      50% { transform: translateX(-10px) rotate(5deg); }
      70% { transform: translateX(10px) rotate(-5deg); opacity:1; }
      100% { transform: scale(.85); opacity:0; }
    }

    @media (max-width: 950px) {
      body { overflow: auto; }
      .game { height: auto; min-height: 100vh; }
      main { grid-template-columns: 1fr; }
      .planet { display:none; }
    }
  </style>
</head>
<body>
  <div class="game">
    <div class="planet one"></div>
    <div class="planet two"></div>
    <div class="planet three"></div>
    <div class="stars-bg"><span>★</span><span>✦</span><span>★</span><span>✧</span><span>★</span></div>

    <header>
      <h1>一年级数学：近似值太空大对决</h1>
      <div class="subtitle">⭐ 根据马来西亚教育部 DSKP 设计 ⭐</div>
      <div class="focus"><b>学习重点：</b>估计数量、十位近似值</div>
    </header>

    <main>
      <section class="team blue" id="teamA">
        <div class="team-title">🚀 A组 蓝队</div>
        <div class="question-card">
          <div>
            <div class="question-row">
              <span class="qbadge">Q<span id="roundA">1</span></span>
              <span id="questionA">37 最接近哪一个十位数？</span>
            </div>
            <div class="visual-stars" id="visualA"></div>
          </div>
          <div class="options" id="optionsA"></div>
        </div>
        <div class="score-box">
          <span class="trophy">🏆</span>
          <span>分数：<span class="score" id="scoreA">0</span></span>
          <span class="stars-earned" id="starsA"></span>
        </div>
      </section>

      <aside class="center-panel">
        <div class="round-note">每轮两组题目都不一样</div>
        <div class="feedback-card good">
          <div class="big-star">⭐</div>
          <div class="feedback-text">答对 <span class="yellow">+10分</span><div class="sound">🔊 快乐音效 ♪</div></div>
        </div>
        <div class="feedback-card bad">
          <div class="meteor-scene"><span class="ship">🛸</span><span class="rock">☄️</span></div>
          <div class="feedback-text"><span class="red">答错：</span><br>撞到陨石<div class="sound">🔊 碰撞音效！</div></div>
        </div>
        <div class="controls">
          <button class="main-btn" onclick="nextRound()">下一题 ➜</button>
          <button class="small-btn" onclick="resetGame()">重新开始</button>
        </div>
        <div class="result-banner" id="resultBanner">请两组同学选择答案！</div>
      </aside>

      <section class="team pink" id="teamB">
        <div class="team-title">🛰️ B组 红队</div>
        <div class="question-card">
          <div>
            <div class="question-row">
              <span class="qbadge">Q<span id="roundB">1</span></span>
              <span id="questionB">图中星星大约有多少颗？</span>
            </div>
            <div class="visual-stars" id="visualB"></div>
          </div>
          <div class="options" id="optionsB"></div>
        </div>
        <div class="score-box">
          <span class="trophy">🏆</span>
          <span>分数：<span class="score" id="scoreB">0</span></span>
          <span class="stars-earned" id="starsB"></span>
        </div>
      </section>
    </main>

    <footer>⭐ DSKP Tahun 1 Matematik：Estimate & Round Off｜适合白板触控荧幕互动 ⭐</footer>
  </div>

  <div class="overlay"><div class="pop" id="popEffect"></div></div>

  <script>
    const questionsA = [
      { q: "37 最接近哪一个十位数？", options: ["20", "30", "40", "50"], answer: "40", visual: "" },
      { q: "62 最接近哪一个十位数？", options: ["50", "60", "70", "80"], answer: "60", visual: "" },
      { q: "18 最接近哪一个十位数？", options: ["10", "20", "30", "40"], answer: "20", visual: "" },
      { q: "84 最接近哪一个十位数？", options: ["60", "70", "80", "90"], answer: "80", visual: "" },
      { q: "46 最接近哪一个十位数？", options: ["30", "40", "50", "60"], answer: "50", visual: "" },
      { q: "73 最接近哪一个十位数？", options: ["60", "70", "80", "90"], answer: "70", visual: "" },
      { q: "29 最接近哪一个十位数？", options: ["10", "20", "30", "40"], answer: "30", visual: "" },
      { q: "95 最接近哪一个十位数？", options: ["80", "90", "100", "70"], answer: "100", visual: "" }
    ];

    const questionsB = [
      { q: "图中星星大约有多少颗？", options: ["8", "12", "20", "30"], answer: "12", visual: "⭐⭐⭐⭐⭐<br>⭐⭐⭐⭐<br>⭐⭐⭐" },
      { q: "图中火箭大约有多少支？", options: ["5", "10", "20", "40"], answer: "10", visual: "🚀🚀🚀🚀<br>🚀🚀🚀<br>🚀🚀" },
      { q: "图中月亮大约有多少个？", options: ["6", "10", "15", "25"], answer: "10", visual: "🌙🌙🌙<br>🌙🌙🌙<br>🌙🌙🌙" },
      { q: "图中星球大约有多少个？", options: ["4", "10", "20", "50"], answer: "10", visual: "🪐🪐🪐<br>🪐🪐🪐<br>🪐🪐" },
      { q: "58 最接近哪一个十位数？", options: ["40", "50", "60", "70"], answer: "60", visual: "" },
      { q: "24 最接近哪一个十位数？", options: ["10", "20", "30", "40"], answer: "20", visual: "" },
      { q: "67 最接近哪一个十位数？", options: ["50", "60", "70", "80"], answer: "70", visual: "" },
      { q: "41 最接近哪一个十位数？", options: ["30", "40", "50", "60"], answer: "40", visual: "" }
    ];

    let round = 0;
    let scoreA = 0;
    let scoreB = 0;
    let answeredA = false;
    let answeredB = false;

    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

    function playCorrectSound() {
      playTone(660, 0.08, "sine", 0.16);
      setTimeout(() => playTone(880, 0.10, "sine", 0.16), 90);
      setTimeout(() => playTone(1180, 0.14, "triangle", 0.13), 190);
    }

    function playWrongSound() {
      playTone(180, 0.12, "sawtooth", 0.12);
      setTimeout(() => playTone(90, 0.20, "square", 0.10), 130);
    }

    function playTone(freq, duration, type, volume) {
      if (audioCtx.state === "suspended") audioCtx.resume();
      const oscillator = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      oscillator.type = type;
      oscillator.frequency.value = freq;
      gain.gain.setValueAtTime(volume, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
      oscillator.connect(gain);
      gain.connect(audioCtx.destination);
      oscillator.start();
      oscillator.stop(audioCtx.currentTime + duration);
    }

    function renderQuestion(team, data, answeredFlag) {
      const qEl = document.getElementById(team === "A" ? "questionA" : "questionB");
      const visualEl = document.getElementById(team === "A" ? "visualA" : "visualB");
      const optionsEl = document.getElementById(team === "A" ? "optionsA" : "optionsB");
      const roundEl = document.getElementById(team === "A" ? "roundA" : "roundB");
      qEl.textContent = data.q;
      visualEl.innerHTML = data.visual || "";
      roundEl.textContent = round + 1;
      optionsEl.innerHTML = "";

      data.options.forEach((opt, index) => {
        const letters = ["A", "B", "C", "D"];
        const btn = document.createElement("button");
        btn.className = "option";
        btn.innerHTML = `<span class="letter">${letters[index]}</span><span>${opt}</span>`;
        btn.onclick = () => answer(team, opt, data.answer, btn);
        optionsEl.appendChild(btn);
      });
    }

    function answer(team, selected, correct, btn) {
      if (team === "A" && answeredA) return;
      if (team === "B" && answeredB) return;

      const isCorrect = selected === correct;
      const optionsEl = document.getElementById(team === "A" ? "optionsA" : "optionsB");
      const buttons = optionsEl.querySelectorAll("button");
      buttons.forEach(b => {
        const value = b.querySelector("span:last-child").textContent;
        if (value === correct) b.classList.add("correct");
      });

      if (isCorrect) {
        btn.classList.add("correct");
        playCorrectSound();
        showPop("⭐ 答对！+10");
        if (team === "A") {
          scoreA += 10;
          answeredA = true;
          document.getElementById("scoreA").textContent = scoreA;
          document.getElementById("starsA").textContent += "⭐";
          document.getElementById("resultBanner").textContent = "A组答对！获得一颗发光星星！";
        } else {
          scoreB += 10;
          answeredB = true;
          document.getElementById("scoreB").textContent = scoreB;
          document.getElementById("starsB").textContent += "⭐";
          document.getElementById("resultBanner").textContent = "B组答对！获得一颗发光星星！";
        }
      } else {
        btn.classList.add("wrong");
        playWrongSound();
        showPop("☄️ 撞到陨石！", false);
        if (team === "A") answeredA = true;
        if (team === "B") answeredB = true;
        document.getElementById("resultBanner").textContent = `${team}组答错了，撞到陨石！正确答案是 ${correct}`;
      }
    }

    function showPop(text, correct = true) {
      const pop = document.getElementById("popEffect");
      pop.className = "pop";
      pop.textContent = text;
      void pop.offsetWidth;
      pop.classList.add(correct ? "show-correct" : "show-wrong");
      setTimeout(() => pop.className = "pop", 1150);
    }

    function nextRound() {
      round = (round + 1) % Math.min(questionsA.length, questionsB.length);
      answeredA = false;
      answeredB = false;
      renderQuestion("A", questionsA[round]);
      renderQuestion("B", questionsB[round]);
      document.getElementById("resultBanner").textContent = "新一轮开始！请两组同学选择答案！";
    }

    function resetGame() {
      round = 0;
      scoreA = 0;
      scoreB = 0;
      answeredA = false;
      answeredB = false;
      document.getElementById("scoreA").textContent = "0";
      document.getElementById("scoreB").textContent = "0";
      document.getElementById("starsA").textContent = "";
      document.getElementById("starsB").textContent = "";
      renderQuestion("A", questionsA[round]);
      renderQuestion("B", questionsB[round]);
      document.getElementById("resultBanner").textContent = "请两组同学选择答案！";
    }

    renderQuestion("A", questionsA[round]);
    renderQuestion("B", questionsB[round]);
  </script>
</body>
